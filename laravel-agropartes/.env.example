APP_NAME="AgroPartes Tractores S.R.L."
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/La_Paz
APP_URL=http://127.0.0.1:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

BCRYPT_ROUNDS=10

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Por defecto SQLite para probar en 1 minuto sin configurar MySQL.
# Si usas XAMPP / MySQL, cambia DB_CONNECTION=mysql y descomenta los datos de abajo:
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=agropartes_tractores
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
